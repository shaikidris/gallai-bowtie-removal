/-- All718 rich merging records and both separated-pair records are accepted. -/
theorem accepted (b : Fin 12) (o : Fin 15) (i : Fin 4) :
    if special b o i then
      SeparatedAccepted (state b o) i (words b o i 0) (words b o i 1) (added b o i)
    else AcceptedRecord (state b o) i (words b o i) (added b o i) := by
  fin_cases b
  · exact Block00.accepted o i
  · exact Block01.accepted o i
  · exact Block02.accepted o i
  · exact Block03.accepted o i
  · exact Block04.accepted o i
  · exact Block05.accepted o i
