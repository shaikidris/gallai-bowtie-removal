import Gallai.Certificates.ThreeAnchorZero
import Gallai.Certificates.ThreeAnchorRetainedOrbits

/-! # Independent high-activity zero-syndrome universe and normalization -/
namespace Gallai.Certificate.ThreeAnchor.ZeroOrbits
open Orbits RetainedOrbits

def HighZero (n : Fin 1024) : Prop :=
  3 ≤ (Finset.univ.filter fun j : Fin 5 => j ≠ 0 ∧ decode n j ≠ 0).card ∧
    syndrome (decode n) = ∅
instance (n : Fin 1024) : Decidable (HighZero n) := by unfold HighZero; infer_instance

set_option maxRecDepth 100000 in
theorem highZero_card : (Finset.univ.filter HighZero).card = 189 := by decide

def NormalizesZero (s : State) (r : Fin 10) (c : Fin 8) (a : Fin 6) : Prop :=
  ∀ j : Fin 5, ∀ k : Fin 3,
    (rowMask (s (coreOrder c j))).val.testBit (anchorOrder a k).val =
      (rowMask (ZeroCatalogue.state r j)).val.testBit k.val
instance (s : State) (r : Fin 10) (c : Fin 8) (a : Fin 6) :
    Decidable (NormalizesZero s r c a) := by unfold NormalizesZero; infer_instance

